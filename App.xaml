<Application x:Class="StudentManagementSystem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/LoginWindow.xaml">
	<Application.Resources>
		<ResourceDictionary>
			<SolidColorBrush x:Key="PrimaryBrush" Color="#0F172A"/>
			<SolidColorBrush x:Key="AccentBrush" Color="#0D9488"/>
			<SolidColorBrush x:Key="SidebarBrush" Color="#0F172A"/>
			<SolidColorBrush x:Key="SidebarHover" Color="#1E293B"/>
			<SolidColorBrush x:Key="BackgroundBrush" Color="#E2E8F0"/>
			<SolidColorBrush x:Key="GlassBrush" Color="#FFFFFF"/>
			<SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
			<SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
			<SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
		</ResourceDictionary>
	</Application.Resources>
</Application>
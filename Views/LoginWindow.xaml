<Window x:Class="StudentManagementSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System"
        Height="640" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9">
	<Grid>
		<Border Margin="50" CornerRadius="20" Padding="48"
                BorderBrush="#40FFFFFF" BorderThickness="1">
			<Border.Background>
				<SolidColorBrush Color="White" Opacity="0.8"/>
			</Border.Background>
			<Border.Effect>
				<DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.12" Color="#000000"/>
			</Border.Effect>

			<StackPanel VerticalAlignment="Center">
				<!-- Logo -->
				<Border Background="{StaticResource PrimaryBrush}" CornerRadius="18" Width="90" Height="90"
                        HorizontalAlignment="Center" Margin="0,0,0,28">
					<TextBlock Text="SMS" FontSize="28" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>

				<TextBlock Text="Welcome back" FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
				<TextBlock Text="Sign in to continue" FontSize="15"
                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,40"/>

				<!-- Username -->
				<TextBlock Text="Username" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
				<TextBox x:Name="UsernameBox" Height="48" Padding="16,0" FontSize="15"
                         BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Background="#F8FAFC"/>

				<!-- Password -->
				<TextBlock Text="Password" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
				<PasswordBox x:Name="PasswordBox" Height="48" Padding="16,0" FontSize="15"
                             BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,36" Background="#F8FAFC"/>

				<!-- Button -->
				<Button Content="Sign In" Click="Login_Click" Height="50" FontSize="16" FontWeight="SemiBold"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}" CornerRadius="10">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</ControlTemplate>
					</Button.Template>
				</Button>

				<TextBlock x:Name="ErrorText" Foreground="#DC2626" HorizontalAlignment="Center"
                           Margin="0,20,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>
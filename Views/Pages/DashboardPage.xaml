<Page x:Class="StudentManagementSystem.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard"
      Background="#F1F5F9">
	<ScrollViewer>
		<StackPanel Margin="36">
			<TextBlock Text="Dashboard" FontSize="30" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
			<TextBlock Text="Overview of your institution" FontSize="14" Foreground="#64748B" Margin="0,0,0,32"/>

			<UniformGrid Columns="4" Margin="0,0,0,36">
				<Border CornerRadius="16" Padding="22" Margin="0,0,14,0" BorderBrush="#40FFFFFF" BorderThickness="1">
					<Border.Background>
						<SolidColorBrush Color="White" Opacity="0.7"/>
					</Border.Background>
					<Border.Effect>
						<DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.08" Color="#000"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="Total Students" FontSize="13" Foreground="#64748B"/>
						<TextBlock x:Name="TotalStudents" FontSize="34" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
					</StackPanel>
				</Border>

				<Border CornerRadius="16" Padding="22" Margin="7,0" BorderBrush="#40FFFFFF" BorderThickness="1">
					<Border.Background>
						<SolidColorBrush Color="White" Opacity="0.7"/>
					</Border.Background>
					<Border.Effect>
						<DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.08" Color="#000"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="Active Courses" FontSize="13" Foreground="#64748B"/>
						<TextBlock x:Name="TotalCourses" FontSize="34" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
					</StackPanel>
				</Border>

				<Border CornerRadius="16" Padding="22" Margin="7,0" BorderBrush="#40FFFFFF" BorderThickness="1">
					<Border.Background>
						<SolidColorBrush Color="White" Opacity="0.7"/>
					</Border.Background>
					<Border.Effect>
						<DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.08" Color="#000"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="Enrollments" FontSize="13" Foreground="#64748B"/>
						<TextBlock x:Name="TotalEnrollments" FontSize="34" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
					</StackPanel>
				</Border>

				<Border CornerRadius="16" Padding="22" Margin="14,0,0,0" BorderBrush="#40FFFFFF" BorderThickness="1">
					<Border.Background>
						<SolidColorBrush Color="White" Opacity="0.7"/>
					</Border.Background>
					<Border.Effect>
						<DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.08" Color="#000"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="Users" FontSize="13" Foreground="#64748B"/>
						<TextBlock x:Name="TotalUsers" FontSize="34" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
					</StackPanel>
				</Border>
			</UniformGrid>

			<TextBlock Text="Recent Activity" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,14"/>
			<Border CornerRadius="16" Padding="6" BorderBrush="#40FFFFFF" BorderThickness="1">
				<Border.Background>
					<SolidColorBrush Color="White" Opacity="0.7"/>
				</Border.Background>
				<Border.Effect>
					<DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.08" Color="#000"/>
				</Border.Effect>
				<DataGrid x:Name="RecentGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="#F8FAFC">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140"/>
						<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
						<DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=g}" Width="160"/>
					</DataGrid.Columns>
				</DataGrid>
			</Border>
		</StackPanel>
	</ScrollViewer>
</Page>
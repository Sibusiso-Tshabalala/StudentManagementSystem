<Window x:Class="StudentManagementSystem.Views.Dialogs.StudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Student Details" Height="600" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer>
        <StackPanel Margin="25">
            <TextBlock x:Name="TitleText" Text="Add New Student" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBox x:Name="StudentNumberBox" materialDesign:HintAssist.Hint="Student Number *" Margin="0,8"/>
            <TextBox x:Name="FirstNameBox" materialDesign:HintAssist.Hint="First Name *" Margin="0,8"/>
            <TextBox x:Name="LastNameBox" materialDesign:HintAssist.Hint="Last Name *" Margin="0,8"/>
            <TextBox x:Name="EmailBox" materialDesign:HintAssist.Hint="Email" Margin="0,8"/>
            <TextBox x:Name="PhoneBox" materialDesign:HintAssist.Hint="Phone" Margin="0,8"/>
            <DatePicker x:Name="DobPicker" materialDesign:HintAssist.Hint="Date of Birth" Margin="0,8"/>
            <ComboBox x:Name="GenderBox" materialDesign:HintAssist.Hint="Gender" Margin="0,8">
                <ComboBoxItem Content="Male"/>
                <ComboBoxItem Content="Female"/>
                <ComboBoxItem Content="Other"/>
            </ComboBox>
            <TextBox x:Name="AddressBox" materialDesign:HintAssist.Hint="Address" AcceptsReturn="True" Height="60" Margin="0,8"/>
            <ComboBox x:Name="StatusBox" materialDesign:HintAssist.Hint="Status" Margin="0,8">
                <ComboBoxItem Content="Active"/>
                <ComboBoxItem Content="Graduated"/>
                <ComboBoxItem Content="Suspended"/>
                <ComboBoxItem Content="Withdrawn"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                <Button Content="Cancel" Style="{StaticResource MaterialDesignOutlinedButton}" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Style="{StaticResource MaterialDesignRaisedButton}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>